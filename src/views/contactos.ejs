<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= etiqueta %>
    </title>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/style.css" />
</head>

<!-- AQUÍ EL CAMBIO: agregar las clases al body -->

<body class="contact-page d-flex flex-column min-vh-100">

    <!-- Navbar -->
    <%- include('partials/navegation.ejs') %>

        <!-- Contenido principal: formulario centrado -->
        <main class="flex-grow-1 d-flex align-items-center justify-content-center py-4">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8 col-12">
                        <div class="card contact-card shadow-sm">
                            <!-- Cabecera de la tarjeta -->
                            <div class="card-header contact-card-header text-center">
                                <h3 class="mb-0">Escríbenos</h3>
                            </div>
                            <!-- Cuerpo de la tarjeta con el formulario -->
                            <div class="card-body">
                                <form>
                                    <!-- Campo Nombre -->
                                    <div class="mb-3">
                                        <label for="nombre" class="form-label">Nombre</label>
                                        <input type="text" class="form-control" id="nombre"
                                            placeholder="Escribe tu nombre" />
                                    </div>
                                    <!-- Campo Correo -->
                                    <div class="mb-3">
                                        <label for="correo" class="form-label">Correo electrónico</label>
                                        <input type="email" class="form-control" id="correo"
                                            placeholder="Escribe tu correo electrónico" />
                                    </div>
                                    <!-- Campo Asunto -->
                                    <div class="mb-3">
                                        <label for="asunto" class="form-label">Asunto requerido</label>
                                        <input type="text" class="form-control" id="asunto"
                                            placeholder="Escribe el asunto solicitado" />
                                    </div>
                                    <!-- Campo Mensaje -->
                                    <div class="mb-3">
                                        <label for="mensaje" class="form-label">Mensaje requerido</label>
                                        <textarea class="form-control" id="mensaje" rows="3"
                                            placeholder="Escribe un mensaje breve"></textarea>
                                    </div>
                                    <!-- Botones -->
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn btn-contact">Enviar</button>
                                        <button type="reset" class="btn btn-contact-reset">Limpiar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <%- include('partials/footer') %>

            <!-- Scripts -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
</body>

</html>
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= etiqueta %>
    </title>
    <%- include('partials/head') %>
</head>


<body class="d-flex flex-column min-vh-100">

    <%- include('partials/navegation.ejs') %>

        <!-- Contenido Principal -->

        <main class="flex-grow-1 container py-4 d-flex align-items-center">
            <div class="row w-100 justify-content-center align-items-center">
                <!-- Columna izquierda: texto -->
                <div class="col-lg-6 col-md-12 text-center text-lg-start">
                    <h1 class="display-1 fw-bold text-dark">
                        Simplifica tu vida con <span class="text-success">menús personalizados</span>
                    </h1>
                    <p class="lead text-muted">
                        De la decisión a la mesa en minutos. Nuestra IA genera menús personalizados,
                        crea tu lista de compras y conecta con tus tiendas favoritas. Todo en un solo lugar.
                    </p>
                    <div class="my-4 d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                        <a href="/login" class="btn btn-success btn-lg">Comenzar Gratis</a>
                        <button type="button" class="btn btn-outline-success btn-lg">Ver Demo</button>
                    </div>
                    <div
                        class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-4 align-items-center">
                        <span class="d-flex align-items-center gap-2">
                            <ion-icon name="checkmark-done-circle-outline" class="text-success fs-4"></ion-icon>
                            <span>100% Gratis</span>
                        </span>
                        <span class="d-flex align-items-center gap-2">
                            <ion-icon name="checkmark-done-circle-outline" class="text-success fs-4"></ion-icon>
                            <span>Sin tarjeta de crédito</span>
                        </span>
                    </div>
                </div>

                <!-- Columna derecha: imagen -->
                <div class="col-lg-6 col-md-12 mt-4 mt-lg-0">
                    <img src="/img/img-principal.jpg" alt="NutriPlan" class="img-fluid rounded shadow-lg" />
                </div>
            </div>
        </main>

        <%- include('partials/footer') %>

            <!-- Scripts -->
            <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
            <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
</body>

</html>